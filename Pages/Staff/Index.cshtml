@page
@model Pillar.Pages.Staff.IndexModel
@{ViewData["Title"]="Staff & access";}
<div class="page-heading"><div><span class="eyebrow">TRUSTED ACCESS</span><h1>Your care team.</h1><p>Give each staff member the access they need.</p></div></div>
<section class="panel"><details><summary class="large-summary">+ Create staff account</summary><form method="post" asp-page-handler="Create"><div class="form-grid"><label>Email<input name="email" type="email" maxlength="254" autocomplete="off" required /></label><label>Initial password<input name="password" type="password" minlength="14" maxlength="256" autocomplete="new-password" required /></label><label>Role<select name="role">@foreach(var role in Access.Roles){<option value="@role">@role.Replace('_',' ')</option>}</select></label></div><p class="small muted">Use at least 14 characters, including uppercase, lowercase, a number, and a symbol. Verify the staff member's email and share their credentials privately.</p><button class="button">Create account</button></form></details></section>
<section class="panel"><h2>Staff accounts</h2>@foreach(var s in Model.Staff){<div class="relationship"><div class="section-heading"><strong>@s.S("email")</strong><span class="chip">@(s.T("disabled_at")==null?"Active":"Disabled")</span></div><p>@s.S("roles").Replace('_',' ')</p>@if(s.G("id")!=Model.Actor){<details><summary>Change access</summary><form method="post" asp-page-handler="Access"><input type="hidden" name="userId" value="@s.G("id")" /><label>Role<select name="role">@foreach(var role in Access.Roles){<option value="@role" selected="@(s.S("roles")==role)">@role.Replace('_',' ')</option>}</select></label><label class="check"><input name="disabled" type="checkbox" value="true" checked="@(s.T("disabled_at")!=null)" /> Disable account</label><button class="button secondary">Save access</button></form></details>}</div>}</section>
