@page
@model Pillar.Pages.Account.PasswordModel
@{ViewData["Title"]="Change password";}
<section class="panel narrow"><h1>Change your password</h1><p>Use a unique password of at least 14 characters.</p><form method="post"><div asp-validation-summary="All" class="validation"></div><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><button class="button">Update password</button></form></section>
