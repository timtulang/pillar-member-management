@page "{id:guid}"
@model Pillar.Pages.Events.DetailsModel
@{ViewData["Title"]=Model.Event.S("title");var zone=TimeZoneInfo.FindSystemTimeZoneById(Model.Event.S("time_zone"));}
<a class="back-link" asp-page="Index">← Services & events</a><div class="page-heading"><div><span class="eyebrow">WELCOME EVERYONE IN</span><h1>@Model.Event.S("title")</h1><p>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.Event.T("starts_at")!.Value,DateTimeKind.Utc),zone).ToString("dddd, dd MMM yyyy · h:mm tt") · @zone.Id</p></div><div class="attendance-total"><strong>@Model.Attendees.Count(x=>x.T("voided_at")==null)</strong><span>people checked in</span></div></div>
@if(Model.Event.T("cancelled_at")!=null){<div class="error">This event is cancelled. Check-in is closed.</div>}
<div class="section-grid"><section class="panel"><span class="eyebrow">QUICK CHECK-IN</span><h2>Scan a member ID</h2><p class="muted">Position the QR inside the camera view. Confirm the member's name when it appears.</p>
<div id="scanner" data-url="@Url.Page("Details","Scan",new{id=Model.Id})"><div class="camera-frame"><video id="camera" muted playsinline aria-label="QR scanning camera"></video><span id="camera-placeholder">Camera preview</span></div><canvas id="scan-canvas" hidden></canvas><div class="actions"><button class="button" id="start-camera" type="button">Start camera</button><button class="button secondary" id="stop-camera" type="button" disabled>Stop</button></div><div id="scan-status" class="scan-status" role="status" aria-live="polite">Ready when you are.</div><form id="token-form" method="post" asp-page-handler="Scan"><label for="qr-token">USB scanner / QR payload</label><input id="qr-token" name="token" maxlength="47" autocomplete="off" placeholder="Scan with a USB reader" /><button class="button secondary">Check in</button></form></div>
</section><section class="panel"><h2>Manual check-in</h2><p class="muted">For a forgotten or damaged ID. Every manual entry includes a reason.</p><form method="post" asp-page-handler="Manual"><label>Member ID<input name="memberCode" placeholder="PF-000001" maxlength="24" required /></label><label>Reason<input name="reason" placeholder="e.g. Forgot their ID card" maxlength="300" required /></label><button class="button">Record attendance</button></form><hr/><p class="small muted">Check-in opens @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.Event.T("check_in_opens_at")!.Value,DateTimeKind.Utc),zone).ToString("dd MMM · h:mm tt") and closes @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.Event.T("check_in_closes_at")!.Value,DateTimeKind.Utc),zone).ToString("dd MMM · h:mm tt") (@zone.Id).</p><a class="button secondary" asp-route-id="@Model.Id">Refresh attendance list</a></section></div>
<section class="panel"><div class="section-heading"><h2>Attendance list</h2><span class="small muted">Times shown in @zone.Id</span></div><div class="table-wrap"><table><thead><tr><th>Member</th><th>Member ID</th><th>Checked in</th><th>Method</th><th>Status</th>@if(User.IsInRole("administrator")||User.IsInRole("membership_manager")){<th>Correction</th>}</tr></thead><tbody>@foreach(var a in Model.Attendees){<tr><td>@a.S("first_name") @a.S("surname")</td><td class="mono">@a.S("member_code")</td><td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.T("checked_in_at")!.Value,DateTimeKind.Utc),zone).ToString("h:mm:ss tt")</td><td>@DisplayLabels.Text(a.S("method"))</td><td><span class="chip">@(a.T("voided_at")==null?"Present":"Voided")</span></td>@if(User.IsInRole("administrator")||User.IsInRole("membership_manager")){<td><details><summary>@(a.T("voided_at")==null?"Void":"Reinstate")</summary><form method="post" asp-page-handler="Correct"><input type="hidden" name="attendanceId" value="@a.G("id")" /><input type="hidden" name="restore" value="@(a.T("voided_at")!=null?"true":"false")" /><label>Reason<input name="reason" maxlength="300" required /></label><button class="button secondary">Save correction</button></form></details></td>}</tr>}</tbody></table></div>@if(Model.Attendees.Count==0){<div class="empty"><h3>Ready for the first arrival.</h3><p>Scan a card or record a manual check-in.</p></div>}</section>
@if((User.IsInRole("administrator")||User.IsInRole("membership_manager"))&&Model.Event.T("cancelled_at")==null){<details class="panel"><summary>Event settings</summary><form method="post" asp-page-handler="Cancel"><p>Cancelling this event closes check-in and preserves attendance records.</p><button class="button secondary">Cancel event</button></form></details>}
@section Scripts{<script src="~/vendor/jsQR.js" defer></script><script src="~/js/scanner.js" asp-append-version="true" defer></script>}
