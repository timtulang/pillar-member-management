@page
@model Pillar.Pages.Events.IndexModel
@{ViewData["Title"]="Attendance";}
<div class="page-heading"><div><span class="eyebrow">GATHER & CONNECT</span><h1>Every gathering counts.</h1><p>Choose a service to scan member IDs and welcome people in.</p></div></div>
@if (User.IsInRole("administrator") || User.IsInRole("membership_manager"))
{
    <section class="panel">
        <details open="@(!ViewData.ModelState.IsValid)">
            <summary class="large-summary">+ Create an event</summary>
            <form method="post" data-event-form>
                <div asp-validation-summary="All" class="validation" role="alert"></div>
                <div class="form-grid">
                    <div><label asp-for="Input.Title"></label><input asp-for="Input.Title" placeholder="Sunday worship service" required /><span asp-validation-for="Input.Title" class="field-error"></span></div>
                    <div><label asp-for="Input.Location"></label><input asp-for="Input.Location" /></div>
                    <div><label asp-for="Input.StartsAt"></label><input asp-for="Input.StartsAt" type="datetime-local" required /><span asp-validation-for="Input.StartsAt" class="field-error"></span></div>
                    <div><label asp-for="Input.EndsAt"></label><input asp-for="Input.EndsAt" type="datetime-local" required /><span asp-validation-for="Input.EndsAt" class="field-error"></span></div>
                    <div><label asp-for="Input.TimeZone"></label><input asp-for="Input.TimeZone" list="event-timezones" required /><small class="muted">All occurrences use this local timezone.</small><datalist id="event-timezones"><option value="Asia/Manila"></option><option value="Asia/Hong_Kong"></option><option value="UTC"></option></datalist></div>
                    <div><label asp-for="Input.Repeat"></label><select asp-for="Input.Repeat" data-repeat><option value="none">Does not repeat</option><option value="daily">Daily</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></div>
                </div>
                <div class="recurrence-fields" data-recurrence>
                    <div class="form-grid">
                        <div><label asp-for="Input.Interval"></label><div class="input-with-unit"><input asp-for="Input.Interval" type="number" min="1" max="12" required /><span data-repeat-unit>weeks</span></div><span asp-validation-for="Input.Interval" class="field-error"></span></div>
                        <div><label asp-for="Input.Occurrences"></label><input asp-for="Input.Occurrences" type="number" min="2" max="52" required /><small class="muted">Includes the first event. Maximum 52 occurrences.</small><span asp-validation-for="Input.Occurrences" class="field-error"></span></div>
                    </div>
                    <p class="small muted">Repeats at the same local time. Monthly repeats use the same day of the month, or its last day when that date is unavailable. Each occurrence is created now and managed separately.</p>
                </div>
                <p class="schedule-summary" data-schedule-summary aria-live="polite"></p>
                <details><summary>Check-in window</summary><div class="form-grid">
                    <div><label asp-for="Input.MinutesBefore"></label><input asp-for="Input.MinutesBefore" min="0" max="1440" required /></div>
                    <div><label asp-for="Input.MinutesAfter"></label><input asp-for="Input.MinutesAfter" min="0" max="1440" required /></div>
                </div></details>
                <div class="form-actions"><button class="button" data-create-event>Create event</button></div>
            </form>
        </details>
    </section>
}
<section class="panel"><div class="section-heading"><h2>Services & events</h2><span class="small muted">Upcoming first · Up to 100 events</span></div>@if(Model.Events.Count==0){<div class="empty"><h3>No gatherings yet.</h3><p>A manager can create your first event above.</p></div>}
@foreach(var e in Model.Events){var start=TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(e.T("starts_at")!.Value,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById(e.S("time_zone")));<a class="event-row" asp-page="Details" asp-route-id="@e.G("id")"><div class="date-tile"><strong>@start.ToString("dd")</strong><small>@start.ToString("MMM")</small></div><span class="grow"><strong>@e.S("title")</strong><small>@start.ToString("ddd · h:mm tt") · @e.S("time_zone") · @e.S("location")</small></span><span class="chip">@(e.T("cancelled_at")==null?"Scheduled":"Cancelled")</span><span class="count">@e.N("attendance")<small>checked in</small></span><span>→</span></a>}</section>
