@page
@model Pillar.Pages.Events.IndexModel
@{ViewData["Title"]="Attendance";}
<div class="page-heading"><div><span class="eyebrow">GATHER & CONNECT</span><h1>Every gathering counts.</h1><p>Choose a service to scan member IDs and welcome people in.</p></div></div>
@if(User.IsInRole("administrator")||User.IsInRole("membership_manager")){<section class="panel"><details><summary class="large-summary">+ Create an event</summary><form method="post"><div class="form-grid"><label>Event name<input name="title" maxlength="200" placeholder="Sunday worship service" required /></label><label>Location<input name="location" maxlength="250" /></label><label>Starts at<input name="startsAt" type="datetime-local" required /></label><label>Ends at<input name="endsAt" type="datetime-local" required /></label><label>Timezone<input name="timeZone" value="@Model.Zone" maxlength="100" required /></label><label>Open check-in (minutes before start)<input name="minutesBefore" type="number" value="60" min="0" max="1440" /></label><label>Close check-in (minutes after end)<input name="minutesAfter" type="number" value="30" min="0" max="1440" /></label></div><div class="form-actions"><button class="button">Create event</button></div></form></details></section>}
<section class="panel"><div class="section-heading"><h2>Services & events</h2><span class="small muted">Most recent 100 events</span></div>@if(Model.Events.Count==0){<div class="empty"><h3>No gatherings yet.</h3><p>A manager can create your first event above.</p></div>}
@foreach(var e in Model.Events){var start=TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(e.T("starts_at")!.Value,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById(e.S("time_zone")));<a class="event-row" asp-page="Details" asp-route-id="@e.G("id")"><div class="date-tile"><strong>@start.ToString("dd")</strong><small>@start.ToString("MMM")</small></div><span class="grow"><strong>@e.S("title")</strong><small>@start.ToString("ddd · h:mm tt") · @e.S("time_zone") · @e.S("location")</small></span><span class="chip">@(e.T("cancelled_at")==null?"Scheduled":"Cancelled")</span><span class="count">@e.N("attendance")<small>checked in</small></span><span>→</span></a>}</section>
