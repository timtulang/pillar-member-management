@page
@model Pillar.Pages.IndexModel
@{ ViewData["Title"] = "Overview"; }
<div class="page-heading"><div><span class="eyebrow">TOGETHER, WE GROW</span><h1>Your church, connected.</h1><p>A little clarity for the people and families in your care.</p></div><a class="button" asp-page="/Members/Edit">+ Add a member</a></div>
<div class="stats-grid"><article class="stat"><span>People in our family</span><strong>@Model.Stats.N("people")</strong><small>Active profiles</small></article><article class="stat"><span>Family households</span><strong>@Model.Stats.N("households")</strong><small>Growing together</small></article><article class="stat"><span>Attendance</span><strong>@Model.Stats.N("attendance")</strong><small>Check-ins in the last 30 days</small></article><article class="stat"><span>Ministries</span><strong>@Model.Stats.N("ministries")</strong><small>Places to serve</small></article></div>
<div class="section-grid"><section class="panel"><div class="section-heading"><h2>Recently added</h2><a asp-page="/Members/Index">All members →</a></div>
@if (Model.RecentMembers.Count == 0) { <div class="empty"><span class="empty-mark">＋</span><h3>Your community starts here.</h3><p>Add your first member to begin building your directory.</p><a asp-page="/Members/Edit">Add a member →</a></div> }
@foreach(var p in Model.RecentMembers) { <a class="person-row" asp-page="/Members/Details" asp-route-id="@p.G("id")"><span class="avatar">@p.S("first_name")[0]@p.S("surname")[0]</span><span><strong>@p.S("first_name") @p.S("surname")</strong><small>@p.S("member_code")</small></span><span class="chip">@p.S("congregation_status").Replace('_',' ')</span></a> }
</section><section class="panel"><div class="section-heading"><h2>Gatherings & attendance</h2><a asp-page="/Events/Index">View all →</a></div>
@if (Model.Events.Count == 0) { <div class="empty"><span class="empty-mark">◷</span><h3>Make room for your next gathering.</h3><p>Create a service to start tracking attendance.</p><a asp-page="/Events/Index">Create an event →</a></div> }
@foreach(var e in Model.Events) { <a class="event-row" asp-page="/Events/Details" asp-route-id="@e.G("id")"><span><strong>@e.S("title")</strong><small>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(e.T("starts_at")!.Value, DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById(e.S("time_zone"))).ToString("ddd, dd MMM · h:mm tt")</small></span><span class="count">@e.N("attendance") <small>checked in</small></span></a> }
</section></div>
<section class="care-banner"><div><span class="eyebrow">A FAMILY THROUGH EVERY SEASON</span><h2>Keep the story connected.</h2><p>Follow family relationships as children grow, couples marry, and new households begin.</p></div><a class="button secondary" asp-page="/Families/Index">Explore families →</a></section>
