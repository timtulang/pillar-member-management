@page "{id:guid}"
@model Pillar.Pages.Members.CardModel
@{ViewData["Title"]="Member ID";}
<div class="no-print"><a class="back-link" asp-page="Details" asp-route-id="@Model.Id">← Member profile</a><div class="page-heading"><div><span class="eyebrow">A PLACE TO BELONG</span><h1>Member ID</h1><p>A printable card for @Model.Person.S("first_name") @Model.Person.S("surname").</p></div></div><div asp-validation-summary="All" class="validation"></div></div>
@if(Model.Qr==null){<section class="panel narrow no-print"><h2>Issue a new card</h2><p>This creates a new QR and revokes any previous card for this person. Print or save the card immediately; the same QR cannot be retrieved later.</p><form method="post"><button class="button">Issue printable ID</button></form></section>}
else{<div class="card-stage"><article class="member-card"><div class="card-top"><span class="card-logo">P</span><span>@Model.ChurchName<small>MEMBER IDENTIFICATION</small></span></div><div class="card-body"><div class="card-name">@Model.Person.S("first_name")<br />@Model.Person.S("surname")</div><img src="data:image/png;base64,@Model.Qr" alt="Attendance QR for @Model.Person.S("first_name")" /><div class="card-id">@Model.Person.S("member_code")</div></div><div class="card-bottom">A family through every season.<small>Valid until @Model.Expires?.ToString("dd MMM yyyy")</small></div></article></div><div class="no-print card-actions"><button class="button" type="button" data-print>Print / save PDF</button><p class="small muted">Choose actual size and disable browser headers and footers. Keep the PDF private.</p></div>}
