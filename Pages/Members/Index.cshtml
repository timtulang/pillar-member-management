@page
@model Pillar.Pages.Members.IndexModel
@{ ViewData["Title"] = "Members"; }
<div class="page-heading"><div><span class="eyebrow">PEOPLE & CONNECTION</span><h1>Our church family</h1><p>Every name has a story. Keep yours close.</p></div><a class="button" asp-page="Edit">+ Add a member</a></div>
<section class="panel"><form method="get" class="filters"><label class="sr-only" for="Search">Search members</label><input asp-for="Search" placeholder="Search by name or member ID" maxlength="150" /><label class="sr-only" for="Status">Status</label><select asp-for="Status"><option value="">All statuses</option>@foreach(var s in MemberInput.Statuses) { <option value="@s">@DisplayLabels.Text(s)</option> }</select><label class="check"><input asp-for="Archived" /> Archived</label><button class="button secondary">Search</button></form>
<div class="section-heading"><h2>Directory <span class="subtle-count">@Model.Total</span></h2><span class="small muted">30 people per page</span></div><div class="table-wrap"><table><thead><tr><th>Member</th><th>Member ID</th><th>Status</th><th>Contact</th><th><span class="sr-only">View</span></th></tr></thead><tbody>
@foreach(var p in Model.Members) { <tr><td><a class="strong" asp-page="Details" asp-route-id="@p.G("id")">@p.S("first_name") @p.S("surname")</a></td><td class="mono">@p.S("member_code")</td><td><span class="chip">@DisplayLabels.Text(p.S("congregation_status"))</span></td><td>@p.S("phone")<small>@p.S("email")</small></td><td><a asp-page="Details" asp-route-id="@p.G("id")" aria-label="View @p.S("first_name") @p.S("surname")">→</a></td></tr> }
</tbody></table></div>@if(Model.Members.Count==0){<div class="empty"><h3>No members found.</h3><p>Try another search or add a new person.</p></div>}
<div class="pagination">@if(Model.PageNumber>1){<a asp-route-PageNumber="@(Model.PageNumber-1)" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Archived="@Model.Archived">← Previous</a>}<span>Page @Model.PageNumber</span>@if(Model.PageNumber*30<Model.Total){<a asp-route-PageNumber="@(Model.PageNumber+1)" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-Archived="@Model.Archived">Next →</a>}</div></section>
