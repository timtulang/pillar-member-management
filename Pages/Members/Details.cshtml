@page "{id:guid}"
@model Pillar.Pages.Members.DetailsModel
@{ ViewData["Title"] = Model.Person.S("first_name")+" "+Model.Person.S("surname"); var p=Model.Person; }
<a class="back-link" asp-page="Index">← Member directory</a>
<div class="page-heading"><div><span class="eyebrow">@p.S("member_code")</span><h1>@ViewData["Title"]</h1><span class="chip">@DisplayLabels.Text(p.S("status"))</span> @if(p.T("archived_at")!=null){<span class="chip warn">Archived</span>}</div><div class="actions"><a class="button secondary" asp-page="Edit" asp-route-id="@Model.Id">Edit profile</a><a class="button" asp-page="Card" asp-route-id="@Model.Id">Member ID →</a></div></div>
<div class="profile-grid"><section class="panel"><h2>Personal details</h2><dl class="detail-list"><dt>Birthday</dt><dd>@p.Date("birth_date")</dd><dt>Phone</dt><dd>@p.S("phone")</dd><dt>Email</dt><dd>@p.S("email")</dd><dt>Address</dt><dd>@p.S("residential_address")</dd><dt>Gender</dt><dd>@DisplayLabels.Text(p.S("gender"))</dd><dt>Membership date</dt><dd>@p.Date("membership_date")</dd><dt>Reported civil status</dt><dd>@DisplayLabels.Text(p.S("civil"))</dd><dt>Reported children</dt><dd>@p.S("reported_child_count")</dd><dt>Invited by</dt><dd>@p.S("inviter_name_reported")</dd></dl>
<details class="form-section"><summary>Profile status</summary><p class="small muted">Archiving preserves history and revokes active cards.</p><form method="post" asp-page-handler="Archive"><input type="hidden" name="archive" value="@(p.T("archived_at")==null ? "true":"false")" /><button class="button secondary">@(p.T("archived_at")==null?"Archive member":"Restore member")</button></form></details>
</section><section class="panel"><div class="section-heading"><h2>Household history</h2><a asp-page="/Families/Index">Families →</a></div>
@if(Model.History.Count==0){<p class="muted">No household has been linked yet.</p>}
@foreach(var h in Model.History){<div class="timeline-item"><strong>@h.S("display_name")</strong><p>@DisplayLabels.Text(h.S("role")) · @h.Date("valid_from") → @(h.T("valid_to")==null?"Ongoing":h.Date("valid_to"))</p></div>}
<details><summary>Move to a household</summary><p class="small muted">Closes the previous primary household period. Parent and spouse links stay connected.</p><form method="post" asp-page-handler="Move" class="form-stack"><label>Household<select name="householdId" required><option value="">Choose a household</option>@foreach(var h in Model.Households){<option value="@h.G("id")">@h.S("display_name")</option>}</select></label><label>Role<select name="role"><option value="adult">Adult</option><option value="child">Child</option><option value="dependent">Dependent</option><option value="other">Other</option></select></label><label>Effective date<input name="effective" type="date" required /></label><button class="button">Save household move</button></form></details>
</section></div>
<div class="section-grid"><section class="panel"><h2>Parents & children</h2><p class="small muted">These relationships continue through marriage and household changes.</p>
@foreach(var r in Model.Relatives){<div class="relationship"><a class="strong" asp-page="Details" asp-route-id="@r.G("person_id")">@r.S("first_name") @r.S("surname")</a><p>@r.S("direction") · @DisplayLabels.Text(r.S("kind")) · @(r.T("valid_to")==null?"Ongoing":"Ended "+r.Date("valid_to"))</p>@if(r.T("valid_to")==null){<details><summary>End relationship period</summary><form method="post" asp-page-handler="EndParent"><input type="hidden" name="relationshipId" value="@r.G("id")" /><label>End date (exclusive)<input type="date" name="endedOn" required /></label><button class="button secondary">Record end</button></form></details>}</div>}
@if(Model.Relatives.Count==0){<p class="muted">No parent or child links recorded.</p>}
<details><summary>Link a parent or child</summary><form method="post" asp-page-handler="Parent" class="form-stack"><label>Relative's member ID<input name="relativeCode" placeholder="PF-000001" maxlength="24" required /></label><label>Relative is this member’s<select name="direction"><option value="parent">Parent</option><option value="child">Child</option></select></label><label>Relationship<select name="kind"><option value="biological">Biological</option><option value="adoptive">Adoptive</option><option value="step">Step</option><option value="foster">Foster</option></select></label><label>Start date, if known<input type="date" name="since" /></label><button class="button">Link relationship</button></form><p class="small muted">The selected relative is the parent or child of @p.S("first_name"). Create a profile first if the relative is not in the directory.</p></details>
</section><section class="panel"><h2>Marriage history</h2>
@foreach(var m in Model.Marriages){<div class="relationship"><a class="strong" asp-page="Details" asp-route-id="@m.G("person_id")">@m.S("first_name") @m.S("surname")</a><p>Married @m.Date("married_on") · @(m.T("ended_on")==null?"Ongoing":"Ended "+m.Date("ended_on"))</p>@if(m.T("ended_on")==null){<details><summary>Record the end of this marriage</summary><form method="post" asp-page-handler="EndMarriage" class="form-stack"><input type="hidden" name="marriageId" value="@m.G("id")" /><label>End date (exclusive)<input type="date" name="endedOn" required /></label><label>Reason<select name="reason"><option value="divorce">Divorce</option><option value="annulment">Annulment</option><option value="spouse_death">Spouse death</option><option value="other">Other</option></select></label><button class="button secondary">Record end</button></form></details>}</div>}
@if(Model.Marriages.Count==0){<p class="muted">No marriage has been recorded.</p>}
<details><summary>Record a marriage</summary><form method="post" asp-page-handler="Marriage" class="form-stack"><label>Spouse's member ID<input name="spouseCode" placeholder="PF-000002" maxlength="24" required /></label><label>Marriage date, if known<input type="date" name="marriedOn" /></label><button class="button">Record marriage</button></form></details>
</section></div>
<div class="section-grid"><section class="panel"><h2>Ministry involvement</h2>
@foreach(var m in Model.Ministries){<div class="relationship"><strong>@m.S("name") @(m.B("is_main")?"· Main":"")</strong><p>@m.S("role_name") · @m.Date("valid_from") → @(m.T("valid_to")==null?"Ongoing":m.Date("valid_to"))</p>@if(m.T("valid_to")==null){<details><summary>End assignment</summary><form method="post" asp-page-handler="EndMinistry"><input type="hidden" name="assignmentId" value="@m.G("id")" /><label>End date<input type="date" name="endedOn" required /></label><button class="button secondary">End assignment</button></form></details>}</div>}
<details><summary>Add ministry assignment</summary><form method="post" asp-page-handler="Ministry" class="form-stack"><label>Ministry<select name="ministryId" required>@foreach(var m in Model.MinistryOptions){<option value="@m.G("id")">@m.S("name")</option>}</select></label><label>Role<select name="roleId"><option value="">Not yet confirmed</option>@foreach(var r in Model.Roles){<option value="@r.G("id")">@r.S("name")</option>}</select></label><label class="check"><input type="checkbox" name="main" value="true" /> Main ministry</label><label>Start date, if known<input type="date" name="since" /></label><button class="button">Add assignment</button></form></details>
<h3>Interested in serving</h3>@foreach(var m in Model.Preferences){<form method="post" asp-page-handler="Preference" class="inline-form"><input type="hidden" name="ministryId" value="@m.G("id")" /><input type="hidden" name="remove" value="true" /><span>@m.S("name")</span><button class="text-button">Remove</button></form>}
<details><summary>Add a ministry preference</summary><form method="post" asp-page-handler="Preference"><label>Ministry<select name="ministryId">@foreach(var m in Model.MinistryOptions){<option value="@m.G("id")">@m.S("name")</option>}</select></label><button class="button secondary">Save interest</button></form></details>
</section><section class="panel"><h2>Discipleship & baptism</h2>
@foreach(var e in Model.Enrollments){<div class="relationship"><strong>@e.S("name")</strong><p>@DisplayLabels.Text(e.S("progress")) · Completed @e.Date("completed_on")</p></div>}
<details><summary>Add or update progress</summary><form method="post" asp-page-handler="Progress" class="form-stack"><label>Program<select name="programId" required>@foreach(var g in Model.Programs){<option value="@g.G("id")">@g.S("name")</option>}</select></label><label>Status<select name="status"><option value="reported_participation">Reported participation</option><option value="in_progress">In progress</option><option value="completed">Completed</option><option value="paused">Paused</option></select></label><label>Started on<input type="date" name="startedOn" /></label><label>Completed on<input type="date" name="completedOn" /></label><button class="button">Save progress</button></form></details>
<h3>Baptism</h3>@foreach(var b in Model.Baptisms){<p>@b.Date("baptized_on") · @DisplayLabels.Text(b.S("place")) @b.S("church_name")</p>}
<details><summary>Record a confirmed baptism</summary><form method="post" asp-page-handler="Baptism" class="form-stack"><label>Date, if known<input type="date" name="baptizedOn" /></label><label>Location<select name="location"><option value="pillar">Pillar</option><option value="elsewhere">Elsewhere</option><option value="unknown">Unknown</option></select></label><label>Church name, if elsewhere<input name="churchName" maxlength="200" /></label><button class="button">Record baptism</button></form></details>
</section></div>
<div class="section-grid"><section class="panel"><h2>Recent attendance</h2>@if(Model.Attendance.Count==0){<p class="muted">No attendance recorded yet.</p>}@foreach(var a in Model.Attendance){<div class="event-row"><span><strong>@a.S("title")</strong><small>@a.Date("starts_at")</small></span><span class="chip">@(a.T("voided_at")==null?"Present":"Voided")</span></div>}</section><section class="panel"><h2>Recent ID cards</h2>@foreach(var c in Model.Cards){<div class="relationship"><p>Issued @c.Date("issued_at") · Expires @c.Date("expires_at")</p>@if(c.T("revoked_at")!=null){<span class="chip">Revoked</span>}else{<form method="post" asp-page-handler="Revoke"><input type="hidden" name="cardId" value="@c.G("id")" /><button class="button secondary">Revoke this card</button></form>}</div>}</section></div>
