@page "{id:guid?}"
@model Pillar.Pages.Members.EditModel
@{ ViewData["Title"] = Model.Id==null ? "Add a member" : "Edit member"; }
<a class="back-link" asp-page="Index">← Member directory</a><div class="page-heading"><div><span class="eyebrow">MEMBER CARE</span><h1>@ViewData["Title"]</h1><p>Start with the essentials. Unknown details can stay blank.</p></div></div>
<form method="post" class="panel" data-member-form><div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Input.Version" /><h2>Personal details</h2><div class="form-grid">
<div><label asp-for="Input.FirstName"></label><input asp-for="Input.FirstName" required /><span asp-validation-for="Input.FirstName" class="field-error"></span></div><div><label asp-for="Input.Surname"></label><input asp-for="Input.Surname" required /><span asp-validation-for="Input.Surname" class="field-error"></span></div>
<div><label asp-for="Input.MiddleName"></label><input asp-for="Input.MiddleName" /><span asp-validation-for="Input.MiddleName" class="field-error"></span></div><div><label asp-for="Input.Suffix"></label><input asp-for="Input.Suffix" /><span asp-validation-for="Input.Suffix" class="field-error"></span></div>
<div><label asp-for="Input.PreferredName"></label><input asp-for="Input.PreferredName" /><span asp-validation-for="Input.PreferredName" class="field-error"></span></div><div><label asp-for="Input.Gender"></label><select asp-for="Input.Gender"><option value="">Not provided</option>@foreach (var gender in MemberInput.Genders) { <option value="@gender">@DisplayLabels.Text(gender)</option> }@if (!string.IsNullOrEmpty(Model.Input.Gender) && !MemberInput.Genders.Contains(Model.Input.Gender)) { <option value="@Model.Input.Gender">Current value: @Model.Input.Gender — choose an option above</option> }</select><span asp-validation-for="Input.Gender" class="field-error"></span></div>
<div><label asp-for="Input.BirthDate"></label><input asp-for="Input.BirthDate" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" /><span asp-validation-for="Input.BirthDate" class="field-error"></span></div><div><label asp-for="Input.CivilStatus"></label><select asp-for="Input.CivilStatus">@foreach(var s in MemberInput.CivilStatuses){<option value="@s">@DisplayLabels.Text(s)</option>}</select></div>
<div><label asp-for="Input.ChildCount"></label><input asp-for="Input.ChildCount" min="0" max="100" /><span asp-validation-for="Input.ChildCount" class="field-error"></span></div><div><label asp-for="Input.DeceasedOn"></label><input asp-for="Input.DeceasedOn" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" /><span asp-validation-for="Input.DeceasedOn" class="field-error"></span></div></div>
<h2 class="form-section">Contact information</h2><div class="form-grid"><div><label asp-for="Input.Phone"></label><input asp-for="Input.Phone" type="tel" /><span asp-validation-for="Input.Phone" class="field-error"></span></div><div><label asp-for="Input.Email"></label><input asp-for="Input.Email" /><span asp-validation-for="Input.Email" class="field-error"></span></div><div class="span-two"><label asp-for="Input.Address"></label><textarea asp-for="Input.Address" maxlength="2000" rows="2"></textarea></div></div>
<h2 class="form-section">Church connection</h2><div class="form-grid"><div><label asp-for="Input.Status"></label><select asp-for="Input.Status">@foreach(var s in MemberInput.Statuses){<option value="@s">@DisplayLabels.Text(s)</option>}</select></div><div><label asp-for="Input.MembershipDate"></label><input asp-for="Input.MembershipDate" /><span asp-validation-for="Input.MembershipDate" class="field-error"></span></div><div><label asp-for="Input.Inviter"></label><input asp-for="Input.Inviter" /><span asp-validation-for="Input.Inviter" class="field-error"></span></div></div>
<div class="form-actions"><button class="button">Save member</button><a class="button secondary" asp-page="Index">Cancel</a></div></form>
